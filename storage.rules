rules_version = '2';
// Regras do Firebase Storage — COLAR no Console: Firebase → Storage → Regras.
// (O Storage é separado do RTDB, que usa database.rules.json.)
//
// O roster de jogadores (cash-roster/) tem PII → só usuário AUTENTICADO lê/escreve.
// Isso mantém a PII fora do repo público e exige login do Suprema pra ver.
// Endurecer depois: checar acesso ao painel cash via custom claims quando o RBAC
// da Etapa 2 estiver ligado. Ver database.rules.target.json.
service firebase.storage {
  match /b/{bucket}/o {
    // roster de jogadores da mesa cash (arquivos .json.gz por semana)
    match /cash-roster/{file} {
      // Só autenticado (inclui login anônimo). Simples de propósito p/ eliminar
      // falha de permissão; o teto de tamanho pode voltar depois.
      allow read, write: if request.auth != null;
    }
    // tudo o mais: negado por padrão
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
